{
  "name": "@rastro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copiar-migrations.mjs",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@rastro/core": "*",
    "fastify": "^5.0.0",
    "postgres": "^3.4.0",
    "unzipper": "^0.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
