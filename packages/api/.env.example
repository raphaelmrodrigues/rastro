PORT=4891

# Em producao, use o host INTERNO que o Dokploy mostra para o servico de banco
# (algo como rastro-db-desenv:5432), nunca o "external host" com o IP publico:
# o trafego entre os dois containers nao precisa sair para a internet.
#
# Se a senha tiver caractere especial (@ : / ?), escape-o. "Rafael@091295" vira
# "Rafael%40091295". O driver daqui aguenta a forma crua, mas psql, pg_dump e
# ferramentas graficas nao — e voce vai precisar delas no dia do backup.
DATABASE_URL=postgres://rastro:rastro@localhost:5432/rastro

# Origens autorizadas a chamar a API pelo navegador, separadas por virgula.
# O app nativo nao manda Origin e nao e afetado; isto e para a versao web.
# Nao use "*": daria a qualquer site aberto no navegador do usuario o direito
# de chamar a API em nome dele.
CORS_ORIGINS=https://rastro.urlsnapshot.com

# Teto global por minuto, por usuario autenticado (ou por IP, se anonimo).
# As rotas de senha tem limite proprio e bem mais apertado.
RATE_LIMIT_MAX=300

# Assina os access tokens. Gere com: openssl rand -base64 48
# Trocar este valor invalida todos os access tokens em circulacao — os refresh
# tokens continuam valendo, entao os apps se recuperam sozinhos no proximo ciclo.
JWT_SECRET=troque-isto-antes-de-qualquer-deploy

# Obrigatorio em producao. Sem isto, JWT_SECRET e TOKEN_ENCRYPTION_KEY caem em
# valores de desenvolvimento — que estao no codigo-fonte — e a API sobe sem
# reclamar. O Dockerfile ja define, mas declare tambem no painel de deploy.
NODE_ENV=production

# Tamanho maximo do upload.
# O export completo do Instagram passa de 100 MB porque vem cheio de midia. O
# ideal continua sendo o usuario pedir so "Seguidores e seguindo", mas quem nao
# leu a instrucao sobe o zip inteiro, e recusar isso apos ele ter esperado ate
# 48h pelo download e perder o usuario. O servidor filtra em streaming e so
# descompacta as listas de conexoes, entao o custo real e baixo.
# Um export completo real deu 479 MB. 600 aceita com folga.
# O caminho preferido nao passa por aqui: o app manda o snapshot ja processado
# em POST /snapshots/processed, que sao alguns MB em vez de centenas.
MAX_UPLOAD_MB=600

# Dias de retencao do zip bruto apos o processamento. O ideal e 0:
# processar, extrair o snapshot, descartar o arquivo original.
RAW_UPLOAD_RETENTION_DAYS=0

# Chave AES-256 (32 bytes em base64) para cifrar os tokens do modo conectado
# em repouso. Gere com: openssl rand -base64 32
# Obrigatoria em producao se o modo conectado estiver ligado.
TOKEN_ENCRYPTION_KEY=

# --- Modo conectado (opcional) ----------------------------------------------
# Credenciais do app da Meta para a "Instagram API with Instagram Login".
# Sem elas, as rotas /instagram respondem 503 e o resto do produto funciona igual.
#
# Onde obter: developers.facebook.com -> criar app -> produto "Instagram" ->
# "API setup with Instagram login". O redirect abaixo precisa estar cadastrado
# igual na configuracao do app.
#
# Lembrete do que este modo NAO entrega: a lista de quem entrou ou saiu. A API
# oficial nao expoe seguidores individualmente. Daqui so vem numero agregado.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4891/instagram/callback
INSTAGRAM_API_VERSION=v23.0

# --- Notificacao push (opcional) --------------------------------------------
# O Expo aceita envio sem credencial, mas com limite baixo e sem prioridade.
# O access token e gerado em expo.dev -> Access Tokens.
EXPO_ACCESS_TOKEN=

# --- E-mail transacional (opcional ate ter cadastro real) -------------------
# Precisa existir antes do primeiro usuario que esquecer a senha.
# Qualquer provedor SMTP serve; Resend e Postmark tem plano gratuito.
SMTP_URL=
SMTP_FROM="Rastro <nao-responda@seudominio.com.br>"

# --- Assinatura (opcional ate haver cobranca) -------------------------------
# Segredo compartilhado para validar os webhooks das lojas. Sem isso, qualquer
# um que descobrir a URL consegue conceder premium para si mesmo.
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=

# --- Painel do dono (opcional) ----------------------------------------------
# E-mails que podem abrir /admin, separados por virgula. A conta e a mesma do
# app: nao existe senha separada nem token mestre aqui.
#
# Vazio = o painel NAO existe. Todas as rotas /admin respondem 404, inclusive
# para quem esta logado. Esse e o padrao de proposito.
ADMIN_EMAILS=

# Limite de relatos de falha por minuto e por IP. O endpoint /reports aceita
# corpo sem autenticacao (um crash pode acontecer antes do login), entao o
# limite dele e proprio e bem menor que o global.
RATE_LIMIT_REPORTS=20
