{
  "expo": {
    "name": "Rastro",
    "slug": "rastro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "description": "Acompanhe quem entrou e quem saiu da sua lista de seguidores, usando o export oficial de dados do Instagram. Nao pedimos sua senha.",
    "icon": "./assets/icon.png",
    "backgroundColor": "#151824",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151824"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urlsnapshot.rastro"
    },
    "android": {
      "package": "com.urlsnapshot.rastro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151824"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e8a33d"
        }
      ],
      "expo-secure-store"
    ]
  }
}
