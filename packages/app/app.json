{
  "expo": {
    "name": "Rastro",
    "slug": "rastro",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "description": "Acompanhe quem entrou e quem saiu da sua lista de seguidores, usando o export oficial de dados do Instagram. Nao pedimos sua senha.",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0B10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urlsnapshot.rastro"
    },
    "android": {
      "package": "com.urlsnapshot.rastro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B10"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B5CF6"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B10"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cb809037-aee4-4246-9af8-f6ea833beab3"
      }
    },
    "owner": "raphaelmr"
  }
}
