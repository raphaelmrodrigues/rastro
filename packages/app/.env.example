# Copie para .env para apontar o app a outro servidor durante o desenvolvimento.
#
# Sem esta variavel o app usa https://rastro.urlsnapshot.com, que e o padrao
# compilado no bundle — e o que precisa valer no app publicado nas lojas.
#
# O prefixo EXPO_PUBLIC_ e obrigatorio: sem ele o Expo nao expoe a variavel ao
# codigo do app. E ele tambem e o aviso — tudo que comeca com EXPO_PUBLIC_ vai
# junto no bundle e pode ser lido por quem baixar o app. Nunca ponha segredo aqui.
EXPO_PUBLIC_API_URL=http://localhost:4891

# No celular fisico, "localhost" e o proprio aparelho. Use o IP da sua maquina
# na rede local:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4891
